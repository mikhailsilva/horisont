{
  "name": "itles-desktop",
  "version": "0.2.0",
  "description": "ITles — кабинет мониторинга спецтехники для Windows",
  "author": "ITles",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs');fs.rmSync('web',{recursive:true,force:true});fs.cpSync('../../platform/dist','web',{recursive:true})\"",
    "dist:win": "npm run prepare-web && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ru.itles.desktop",
    "productName": "ITles",
    "artifactName": "ITles-Setup.${ext}",
    "files": ["main.js", "web/**/*"],
    "directories": { "output": "release" },
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "shortcutName": "ITles", "language": "1049" }
  }
}
